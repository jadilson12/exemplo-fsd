# Copie para .env e preencha a chave:  cp .env.example .env
# O mise carrega o .env automaticamente (veja `_.file` no mise.toml).
# O .env NAO vai para o git; este .env.example vai.

# Gateway compativel com o protocolo OpenAI:
#   OpenRouter -> https://openrouter.ai/api
#   LiteLLM    -> http://localhost:4000
OPENAI_BASE_URL=https://openrouter.ai/api

# Chave do gateway acima (no OpenRouter: sk-or-v1-...).
OPENAI_API_KEY=coloque-sua-chave-aqui

# Modelo de chat.
MODELO=nvidia/nemotron-3.5-lightning:free

# Modelo que vetoriza os regulamentos e a pergunta (RAG). Sai pelo mesmo
# gateway e pela mesma chave do chat: o OpenRouter expoe /v1/embeddings.
MODELO_EMBEDDING=nvidia/llama-nemotron-embed-vl-1b-v2:free

# Para rodar o embedding dentro da JVM (ONNX all-MiniLM-L6-v2, sem chave e
# sem rede depois do primeiro download de ~90 MB), troque para transformers.
PROVIDER_EMBEDDING=openai

# Aluno autenticado da demo. Vai no header X-Matricula das chamadas MCP.
MATRICULA=20260001
