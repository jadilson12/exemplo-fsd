# Copie para .env e preencha a chave:  cp .env.example .env
# O mise carrega o .env automaticamente (veja `_.file` no mise.toml).
# O .env NAO vai para o git; este .env.example vai.

# ---------------------------------------------------------------------
# Provider do chat:  openai (OpenRouter / OpenAI / Ollama / LiteLLM)
#                    google-genai (Gemini)
# ---------------------------------------------------------------------
PROVIDER=openai

# Provider do embedding do RAG: openai | google-genai | transformers
# (transformers = ONNX all-MiniLM-L6-v2 dentro da JVM, sem chave e sem rede
#  depois do primeiro download de ~90 MB).
PROVIDER_EMBEDDING=openai

# --- PROVIDER=openai --------------------------------------------------
#   OpenRouter -> https://openrouter.ai/api
#   OpenAI     -> https://api.openai.com
#   Ollama     -> http://localhost:11434   (nao valida chave)
#   LiteLLM    -> http://localhost:4000
OPENAI_BASE_URL=https://openrouter.ai/api
OPENAI_API_KEY=coloque-sua-chave-aqui

# --- PROVIDER=google-genai --------------------------------------------
# Chave da Gemini Developer API (Google AI Studio: aistudio.google.com/apikey).
# Para usar o Vertex AI em vez dela, troque as duas `api-key` do bloco
# google.genai do application.yml por `project-id` + `location`.
GOOGLE_API_KEY=

# Modelo de chat (precisa suportar tool calling). Combine com o PROVIDER:
#   openai       -> nvidia/nemotron-3.5-lightning:free, gpt-4o-mini, qwen3:8b
#   google-genai -> gemini-3.8-flash
MODELO=nvidia/nemotron-3.5-lightning:free

# Modelo que vetoriza os regulamentos e a pergunta (RAG). Combine com o
# PROVIDER_EMBEDDING:
#   openai       -> nvidia/llama-nemotron-embed-vl-1b-v2:free
#   google-genai -> gemini-embedding-001
#   transformers -> ignorado (o modelo ONNX ja vem embutido)
MODELO_EMBEDDING=nvidia/llama-nemotron-embed-vl-1b-v2:free
